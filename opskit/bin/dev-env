#!/usr/bin/env bash
# Prepares a Linux dev machine (cloud session, WSL2, or any Ubuntu) for opskit work:
# installs missing ops tools and makes sure a Docker daemon is running.
# Tool-neutral: any person or AI agent can run it. Safe to re-run.
set -euo pipefail

YQ_VERSION="v4.44.3"
YQ_URL="https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/yq_linux_amd64"
YQ_SHA256="a2c097180dd884a8d50c956ee16a9cec070f30a7947cf4ebf87d5f36213e9ed7"

usage() {
  cat <<'EOF'
Usage: opskit/bin/dev-env [--help]

Installs missing tools (shellcheck, bats, rclone, age, jq, envsubst, ssh, node/npx,
curl, git, openssl) with apt, mikefarah yq v4
(pinned, checksum-verified), and
starts the Docker daemon if none is reachable. If HTTPS_PROXY is set, the
daemon is started with it so image pulls go through the proxy.
EOF
}

apt_package_for() {
  case "$1" in
    envsubst) printf 'gettext-base' ;;
    ssh) printf 'openssh-client' ;;
    node) printf 'nodejs' ;;
    npx) printf 'npm' ;;
    *) printf '%s' "$1" ;;
  esac
}

as_root() {
  if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi
}

install_tools() {
  local missing=() tool
  for tool in shellcheck bats rclone age jq envsubst ssh node npx curl git openssl; do
    command -v "$tool" >/dev/null 2>&1 || missing+=("$(apt_package_for "$tool")")
  done
  mapfile -t missing < <(printf '%s\n' "${missing[@]}" | sort -u)
  [ -n "${missing[0]:-}" ] || missing=()
  if [ "${#missing[@]}" -eq 0 ]; then
    echo "[ok] tools present"
    return
  fi
  as_root apt-get update -qq >/dev/null
  if as_root apt-get install -y -qq "${missing[@]}" >/dev/null; then
    echo "[ok] installed: ${missing[*]}"
  else
    echo "[warn] could not install: ${missing[*]}"
  fi
}

install_yq() {
  if yq --version 2>/dev/null | grep -q 'mikefarah.*version v4'; then
    echo "[ok] yq v4 present"
    return
  fi
  if [ "$(uname -m)" != "x86_64" ]; then
    echo "[warn] yq v4 auto-install only supports x86_64; install mikefarah yq v4 by hand"
    return
  fi
  local tmp
  tmp="$(mktemp)"
  if curl -fsSL -o "$tmp" "$YQ_URL" && echo "${YQ_SHA256}  ${tmp}" | sha256sum -c --quiet -; then
    as_root install -m 0755 "$tmp" /usr/local/bin/yq
    echo "[ok] installed yq ${YQ_VERSION} (mikefarah) to /usr/local/bin"
  else
    echo "[warn] could not download/verify yq ${YQ_VERSION}"
  fi
  rm -f "$tmp"
}

start_docker() {
  if docker info >/dev/null 2>&1; then
    echo "[ok] docker daemon running"
    return
  fi
  if ! command -v dockerd >/dev/null 2>&1; then
    echo "[warn] no docker daemon reachable and dockerd not installed (WSL: start Docker Desktop)"
    return
  fi
  if ! pgrep -x dockerd >/dev/null 2>&1; then
    as_root rm -f /var/run/docker.pid
  fi
  as_root env \
    HTTPS_PROXY="${HTTPS_PROXY:-}" HTTP_PROXY="${HTTPS_PROXY:-}" \
    NO_PROXY="${NO_PROXY:-${no_proxy:-}}" \
    sh -c 'nohup dockerd >/var/log/dockerd.log 2>&1 &'
  local _
  for _ in $(seq 1 30); do
    docker info >/dev/null 2>&1 && break
    sleep 1
  done
  if docker info >/dev/null 2>&1; then
    echo "[ok] docker daemon running"
  else
    echo "[warn] docker daemon not running (see /var/log/dockerd.log)"
  fi
}

main() {
  case "${1:-}" in
    -h|--help) usage; return 0 ;;
    "") ;;
    *) usage >&2; return 1 ;;
  esac
  install_tools
  install_yq
  start_docker
}

main "$@"
