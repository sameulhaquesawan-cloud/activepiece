client_id: ${CLIENT_ID}
name: "${CLIENT_NAME}"
contact: ${CLIENT_CONTACT}
domain: ${CLIENT_DOMAIN}
host:
  name: ${HOST_ID}
  ip: ${HOST_IP}
  ssh_user: ${HOST_SSH_USER}
  mode: ${HOST_MODE}
image:
  repo: ghcr.io/activepieces/activepieces
  tag: ${AP_TAG}
ap_version: ${AP_TAG}
workers:
  replicas: 1
  memory_limit: 1g
app:
  memory_limit: 1g
timezone: ${CLIENT_TIMEZONE}
alerts:
  channels: [email]
  email:
    to: [${CLIENT_CONTACT}]
backup:
  schedule: "30 2 * * *"
  retention_days: { local: 14, remote: 30 }
report:
  recipients: [${CLIENT_CONTACT}]
  day_of_month: 1
support:
  response_hours: 12
  included_hours: 1
offboard_retention_days: 30
created_at: ${CREATED_AT}
status: draft
