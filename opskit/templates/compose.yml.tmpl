name: ${CLIENT_ID}

x-logging: &logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

services:
  app:
    image: ${AP_IMAGE}
    restart: unless-stopped
    env_file: .env
    environment:
      AP_CONTAINER_TYPE: APP
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    volumes:
      - cache:/usr/src/app/cache
    networks:
      default: {}
      edge:
        aliases:
          - ${CLIENT_ID}-app
    deploy:
      resources:
        limits:
          memory: ${APP_MEMORY}
    logging: *logging

  worker:
    image: ${AP_IMAGE}
    restart: unless-stopped
    env_file: .env
    environment:
      AP_CONTAINER_TYPE: WORKER
      AP_FRONTEND_URL: http://app
    depends_on:
      - app
    volumes:
      - cache:/usr/src/app/cache
    deploy:
      replicas: ${WORKER_REPLICAS}
      resources:
        limits:
          memory: ${WORKER_MEMORY}
    logging: *logging

  postgres:
    image: ${POSTGRES_IMAGE}
    restart: unless-stopped
    env_file: .env
    volumes:
      - postgres:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U \"$$POSTGRES_USER\" -d \"$$POSTGRES_DB\""]
      interval: 10s
      timeout: 5s
      retries: 10
    deploy:
      resources:
        limits:
          memory: ${POSTGRES_MEMORY}
    logging: *logging

  redis:
    image: ${REDIS_IMAGE}
    restart: unless-stopped
    volumes:
      - redis:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 10
    deploy:
      resources:
        limits:
          memory: ${REDIS_MEMORY}
    logging: *logging

networks:
  default: {}
  edge:
    external: true
    name: opskit_edge

volumes:
  postgres: {}
  redis: {}
  cache: {}
