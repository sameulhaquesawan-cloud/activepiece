                  {
                    "name": "step_7",
                    "displayName": "Label: invoice",
                    "type": "PIECE",
                    "valid": true,
                    "lastUpdatedDate": "2026-10-21T00:00:00.000Z",
                    "settings": {
                      "pieceName": "@activepieces/piece-gmail",
                      "pieceVersion": "0.18.1",
                      "actionName": "gmail_add_label_to_email",
