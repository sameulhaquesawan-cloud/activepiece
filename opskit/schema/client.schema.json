{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opskit.local/schema/client.schema.json",
  "title": "opskit client.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client_id",
    "name",
    "contact",
    "domain",
    "host",
    "image",
    "ap_version",
    "timezone",
    "alerts",
    "backup",
    "status"
  ],
  "properties": {
    "client_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,30}[a-z0-9]$",
      "description": "slug, also the compose project name"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "contact": {
      "type": "string",
      "format": "email"
    },
    "domain": {
      "type": "string",
      "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ip",
        "ssh_user",
        "mode"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,30}[a-z0-9]$"
        },
        "ip": {
          "type": "string",
          "format": "ipv4"
        },
        "ssh_user": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]{0,31}$",
          "not": {
            "const": "root"
          }
        },
        "ssh_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 22
        },
        "mode": {
          "enum": [
            "dedicated",
            "shared"
          ]
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "tag"
      ],
      "properties": {
        "repo": {
          "enum": [
            "ghcr.io/activepieces/activepieces",
            "activepieces/activepieces"
          ],
          "default": "ghcr.io/activepieces/activepieces"
        },
        "tag": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "ap_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 1
        },
        "memory_limit": {
          "$ref": "#/$defs/memory"
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory_limit": {
          "type": "string",
          "pattern": "^((89[6-9]|9[0-9]{2}|[1-9][0-9]{3,5})m|[1-9][0-9]{0,2}g)$",
          "description": "at least 896m: at 640m Node picks a 368 MiB heap and 0.92 runs out of it (field run, 24 Oct 2026)"
        }
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "timezone": {
      "type": "string",
      "pattern": "^(UTC|[A-Z][A-Za-z_]+(/[A-Za-z0-9_+-]+){1,2})$"
    },
    "alerts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channels"
      ],
      "properties": {
        "channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "telegram",
              "email",
              "slack"
            ]
          }
        },
        "telegram": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chat_id"
          ],
          "properties": {
            "chat_id": {
              "type": "string",
              "pattern": "^-?[0-9]{3,20}$"
            }
          }
        },
        "email": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "to"
          ],
          "properties": {
            "to": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "format": "email"
              }
            }
          }
        },
        "slack": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "webhook_secret"
          ],
          "properties": {
            "webhook_secret": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
              "description": "name of the host secret holding the webhook URL, never the URL"
            }
          }
        },
        "quiet_hours": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "$ref": "#/$defs/hhmm"
            },
            "to": {
              "$ref": "#/$defs/hhmm"
            }
          }
        },
        "include_error_excerpt": {
          "type": "boolean",
          "default": true,
          "description": "false = failed-run alerts carry no error text (only flow, step, status, run link); for clients whose errors may contain personal data (EU)"
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "schedule": {
          "type": "string",
          "pattern": "^[0-9*,/-]+( [0-9*,/-]+){4}$",
          "default": "30 2 * * *"
        },
        "retention_days": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "local": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365,
              "default": 14
            },
            "remote": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650,
              "default": 30
            }
          }
        },
        "remote": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+:[A-Za-z0-9_./-]*$",
          "description": "rclone remote:path"
        },
        "heartbeat_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "description": "Uptime Kuma push URL for this client's backup (Phase 4)"
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recipients": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "email"
          }
        },
        "day_of_month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 28,
          "default": 1
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "response_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168,
          "default": 12
        },
        "included_hours": {
          "type": "number",
          "minimum": 0,
          "maximum": 40,
          "default": 1,
          "description": "support hours included per month (Care 1, Care Plus 3); shown as used vs included in the care report"
        }
      }
    },
    "offboard_retention_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365,
      "default": 30
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "draft",
        "deployed",
        "paused",
        "offboarded"
      ]
    },
    "offboarded_at": {
      "type": "string",
      "format": "date"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "event"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "event": {
            "enum": [
              "created",
              "deployed",
              "paused",
              "resumed",
              "offboarded",
              "purged",
              "restored",
              "upgraded",
              "upgrade_failed",
              "rolled_back"
            ]
          },
          "tag": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "app_webhooks": {
      "type": "object",
      "additionalProperties": false,
      "description": "secrets for app-level webhook triggers (AP_APP_WEBHOOK_SECRETS); values are names in clients/<id>/channels.env",
      "properties": {
        "facebook_leads": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "secret"
          ],
          "properties": {
            "secret": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
              "description": "name of the channels.env entry holding the Meta app secret"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "memory": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,5}[mg]$"
    },
    "hhmm": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    }
  }
}
