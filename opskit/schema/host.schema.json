{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opskit.local/schema/host.schema.json",
  "title": "opskit hosts/<host>.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "host_id",
    "ip",
    "ssh_user",
    "mode",
    "cpus",
    "ram_gb"
  ],
  "properties": {
    "host_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,30}[a-z0-9]$"
    },
    "ip": {
      "type": "string",
      "format": "ipv4"
    },
    "ssh_user": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_-]{0,31}$",
      "not": {
        "const": "root"
      }
    },
    "ssh_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 22
    },
    "mode": {
      "enum": [
        "dedicated",
        "shared"
      ]
    },
    "provider": {
      "type": "string",
      "maxLength": 60
    },
    "location": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "description": "where the server stands, as told to clients (e.g. Germany (Falkenstein)); shown in handover packs"
    },
    "cpus": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "ram_gb": {
      "type": "integer",
      "minimum": 2,
      "maximum": 2048
    },
    "port_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "end": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        }
      }
    },
    "clients": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,30}[a-z0-9]$"
      }
    },
    "transport": {
      "enum": [
        "ssh",
        "local"
      ],
      "default": "ssh",
      "description": "local = practice host on this machine (selftest, WSL, Codespace)"
    },
    "opskit_root": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9._/-]+$",
      "default": "/opt/opskit"
    },
    "firewall": {
      "enum": [
        "ufw",
        "keep"
      ],
      "default": "ufw",
      "description": "keep = leave the host's own iptables rules (Oracle images); bootstrap checks they allow ssh/80/443 and reject the rest"
    },
    "swap": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,2}[MG]$",
      "description": "always create a swapfile of this size (default: 2G only when RAM <= 4 GB)"
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "http_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 80
        },
        "https_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 443
        },
        "tls": {
          "enum": [
            "acme",
            "internal"
          ],
          "default": "acme",
          "description": "internal = Caddy local CA (practice hosts, *.localhost)"
        },
        "acme_email": {
          "type": "string",
          "format": "email"
        },
        "container": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,40}$",
          "default": "opskit-caddy"
        },
        "join_networks": {
          "type": "array",
          "uniqueItems": true,
          "description": "shared host: extra Docker networks the edge joins to proxy other projects' sites",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,62}$"
          }
        }
      }
    },
    "practice_quirks": {
      "type": "object",
      "additionalProperties": false,
      "description": "practice/test hosts only",
      "properties": {
        "ipv4_listen_shim": {
          "type": "boolean",
          "default": false,
          "description": "kernel without IPv6: make the app listen on 0.0.0.0"
        }
      }
    },
    "install_cron": {
      "type": "boolean",
      "description": "install backup schedules in the ssh user's crontab (default: true for ssh hosts, false for local practice hosts)"
    },
    "monitor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain"
      ],
      "description": "Uptime Kuma on this host (the owner's monitoring host); see opskit monitor",
      "properties": {
        "domain": {
          "type": "string",
          "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
        },
        "image": {
          "enum": [
            "louislam/uptime-kuma",
            "mirror.gcr.io/louislam/uptime-kuma"
          ],
          "default": "louislam/uptime-kuma"
        },
        "tag": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "default": "2.5.5"
        },
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+[mg]$",
          "default": "512m"
        }
      }
    }
  }
}
