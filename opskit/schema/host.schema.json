{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opskit.local/schema/host.schema.json",
  "title": "opskit hosts/<host>.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["host_id", "ip", "ssh_user", "mode", "cpus", "ram_gb"],
  "properties": {
    "host_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,30}[a-z0-9]$" },
    "ip": { "type": "string", "format": "ipv4" },
    "ssh_user": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$", "not": { "const": "root" } },
    "ssh_port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 22 },
    "mode": { "enum": ["dedicated", "shared"] },
    "provider": { "type": "string", "maxLength": 60 },
    "cpus": { "type": "integer", "minimum": 1, "maximum": 256 },
    "ram_gb": { "type": "integer", "minimum": 2, "maximum": 2048 },
    "port_range": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "end": { "type": "integer", "minimum": 1024, "maximum": 65535 }
      }
    },
    "clients": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,30}[a-z0-9]$" } }
  }
}
